{
  "name": "soul-album",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:backend && npm run build:server",
    "server:dev": "npm run build:server && node dist-server/server/index.js",
    "dev:all": "node scripts/dev-all.mjs",
    "start": "node dist-server/server/index.js",
    "demo:backend": "npm run build:backend && node dist-backend/backend/demo.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
